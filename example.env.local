# =========================================================================
# SRE Command Center - Environment Configuration
# =========================================================================
# Copy this file to .env.local and fill in your REQUIRED values.
# 
# NOTE: Most integrations (GitHub, Prometheus, Slack) are configured 
# through the app's Settings page after login - NOT here!
# =========================================================================

# =====================================
# REQUIRED: Tambo AI Configuration
# =====================================
# Get your API key from: https://tambo.co/dashboard
NEXT_PUBLIC_TAMBO_API_KEY=your-tambo-api-key-here

# =====================================
# REQUIRED: Supabase Configuration
# =====================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =====================================
# REQUIRED: Site URL (for OAuth callbacks)
# =====================================
# Set to http://localhost:3000 for development
# Set to your deployed URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =========================================================================
# OPTIONAL: Developer/Admin Overrides
# =========================================================================
# These environment variables are ONLY for developers or admin testing.
# For normal users, integrations are configured in Settings > Integrations.
# =========================================================================

# GitHub Integration (dev override)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=owner/repo-name

# Prometheus Integration (dev override)
# PROMETHEUS_URL=http://prometheus.monitoring:9090

# Slack Integration (dev override)
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
# SLACK_DEFAULT_CHANNEL=#incidents