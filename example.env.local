# ============================================================================
# SRE Command Center - App Credentials and Environment Template
# ============================================================================
# Copy this file to .env.local and set real values.
# IMPORTANT: Use app-level credentials only (not individual user secrets).
# Never commit real secrets to git.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Core App Credentials (must be set for app to run correctly)
# ----------------------------------------------------------------------------
# Tambo API key for chat and AI features
NEXT_PUBLIC_TAMBO_API_KEY=your_tambo_api_key

# Optional: custom/self-hosted Tambo API URL
# Leave empty to use default hosted Tambo endpoint
NEXT_PUBLIC_TAMBO_URL=

# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site URL used for auth callback redirects
# Local: http://localhost:3000
# Prod:  https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# REQUIRED FOR SLACK OAUTH FLOW (Settings -> Slack -> Connect)
# ----------------------------------------------------------------------------
# Needed by /auth/slack/start and /auth/slack/callback routes
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# ----------------------------------------------------------------------------
# OPTIONAL: Kubernetes Remediation Guardrails (app-level safety switches)
# ----------------------------------------------------------------------------
# Keep false by default. Set true only after validating permissions and safety.
ENABLE_K8S_REMEDIATION=false
ENABLE_K8S_ROLLBACK=false
